<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Declare USB Open Accessory hardware support (optional so UI launches without attached accessory) -->
    <uses-feature
        android:name="android.hardware.usb.accessory"
        android:required="false" />

    <!-- Foreground Service permissions for Galaxy S26 Ultra (Android 16 / compileSdk 36) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Разрешения для вывода полноценных приложений на VirtualDisplay ГУ и фонового запуска -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Zero battery throttling & CPU WakeLock for uninterrupted 60fps H.264 USB AOA streaming -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Разрешаем PackageManager видеть все запускаемые (LAUNCHER) приложения для док-бара на ГУ -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!--
            singleTask activity that intercepts USB_ACCESSORY_ATTACHED when the Head Unit
            switches the smartphone into AOA mode (VID 0x18D1 / PID 0x2D00..0x2D01).
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Intercept Baidu CarLife USB AOA attachment automatically -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>

            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/accessory_filter" />
        </activity>

        <!--
            High-priority Foreground Service managing USB AOA direct ByteBuffer I/O,
            WakeLocks, CarLife protocol multiplexer, and VirtualDisplay H.264 projection.
        -->
        <service
            android:name=".core.usb.BridgeForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|connectedDevice|dataSync" />

        <!--
            NotificationListenerService granting MediaSessionManager access to active media sessions
            (Yandex Music, Spotify, Poweramp, YouTube Music) for the Dock Media Widget.
        -->
        <service
            android:name=".feature.cockpit.CockpitMediaNotificationListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            CarLifeAccessibilityService для проброса касаний и свайпов (канал 0x0006) с тачскрина ГУ
            в любые приложения смартфона в режиме зеркалирования экрана (MediaProjection) и на VirtualDisplay.
        -->
        <service
            android:name=".core.input.CarLifeAccessibilityService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/carlife_accessibility_config" />
        </service>

        <!--
            Провайдер Shizuku для взаимодействия с привилегированным ShizukuUserService (режим Кокпит + Shizuku)
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>
